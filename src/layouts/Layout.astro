---
import "../styles/global.css";

// Fonts (self-hosted via Fontsource)
import "@fontsource/vazirmatn/400.css";
import "@fontsource/vazirmatn/500.css";
import "@fontsource/vazirmatn/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/noto-sans-arabic/400.css";
import "@fontsource/noto-sans-arabic/500.css";
import "@fontsource/handjet/latin-400.css";
import "@fontsource/handjet/latin-500.css";

import fa from "../i18n/en.json";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import portrait from "../assets/morteza-portrait.jpg";

interface Props {
  title?: string;
  description?: string;
}
const { title = fa.meta.title, description = fa.meta.description } = Astro.props;

const nav = [
  { href: "#about", key: "nav.about", label: fa.nav.about },
  { href: "#worlds", key: "nav.worlds", label: fa.nav.worlds },
  { href: "#press", key: "nav.press", label: fa.nav.press },
  { href: "#contact", key: "nav.contact", label: fa.nav.contact },
];

const socials = [
  { name: "github", href: "https://github.com/pourmirzai", label: "GitHub" },
  { name: "linkedin", href: "https://linkedin.com/in/pourmirzai", label: "LinkedIn" },
  { name: "instagram", href: "https://instagram.com/pourmirzai", label: "Instagram" },
  { name: "telegram", href: "https://t.me/pourmirzai", label: "Telegram" },
  { name: "x", href: "https://x.com/pourmirzai", label: "X" },
];
---

<!doctype html>
<html lang="en" dir="ltr" class="bg-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Morteza Pourmirzai" />
    <meta name="theme-color" content="#080a08" />
    <link rel="canonical" href="https://pourmirzai.com" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KRHG9H7P');</script>
    <!-- End Google Tag Manager -->

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pourmirzai.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://pourmirzai.com/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Morteza Pourmirzai — Where Nature Meets Code" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="fa_IR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pourmirzai.com/og.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <!-- Structured data: Person + WebSite (SEO / LLM readability) -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://pourmirzai.com/#person",
            "name": "Morteza Pourmirzai",
            "alternateName": "مرتضی پورمیرزای",
            "url": "https://pourmirzai.com",
            "image": "https://pourmirzai.com/og.png",
            "jobTitle": "Wildlife Conservationist & Web Developer",
            "description": "Wildlife conservation practitioner focused on the Asiatic cheetah in Iran; founder of Sarvin Wildlife Conservation and former CEO of the Iranian Cheetah Society. Also works in web development: AI agents and automation, websites, reporting dashboards, bots, and SEO.",
            "email": "mailto:morteza@pourmirzai.com",
            "knowsLanguage": ["en", "fa"],
            "knowsAbout": [
              "Asiatic cheetah conservation",
              "Camera-trap monitoring",
              "Habitat restoration",
              "AI agents and automation",
              "Web development",
              "Web-based reporting dashboards",
              "Chatbots",
              "SEO",
              "Digital marketing"
            ],
            "memberOf": [
              {
                "@type": "Organization",
                "name": "IUCN Commission on Ecosystem Management",
                "alternateName": "CEM",
                "url": "https://iucn.org/our-union/commissions/commission-ecosystem-management"
              },
              {
                "@type": "Organization",
                "name": "IUCN World Commission on Protected Areas",
                "alternateName": "WCPA",
                "url": "https://iucn.org/our-union/commissions/world-commission-protected-areas"
              }
            ],
            "founderOf": {
              "@type": "Organization",
              "name": "Sarvin Wildlife Conservation",
              "url": "https://sarvinwildlife.com"
            },
            "sameAs": [
              "https://github.com/pourmirzai",
              "https://linkedin.com/in/pourmirzai",
              "https://instagram.com/pourmirzai",
              "https://t.me/pourmirzai",
              "https://x.com/pourmirzai"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://pourmirzai.com/#website",
            "url": "https://pourmirzai.com",
            "name": "Morteza Pourmirzai — Where Nature Meets Code",
            "inLanguage": ["en", "fa"],
            "about": { "@id": "https://pourmirzai.com/#person" },
            "publisher": { "@id": "https://pourmirzai.com/#person" }
          }
        ]
      }
    </script>

    <!-- Pre-paint language and theme setup -->
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem("lang");
          var el = document.documentElement;
          if (l === "fa") {
            el.lang = "fa";
            el.dir = "rtl";
          } else {
            el.lang = "en";
            el.dir = "ltr";
          }
          el.classList.add("js-ready");
        } catch (e) {
          document.documentElement.classList.add("js-ready");
        }
        window.addEventListener("load", function () {
          setTimeout(function () {
            if (!window.__APP_BOOTED__) {
              document.documentElement.classList.add("reveal-safe");
            }
          }, 2500);
        });
      })();
    </script>
  </head>

  <body class="selection:bg-tech-cyan selection:text-tech-navy">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KRHG9H7P"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Custom Magnetic Cursor (Desktop only) -->
    <div class="custom-cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <div class="cursor-ring"></div>
    </div>

    <!-- Skip link -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-tech-cyan focus:px-4 focus:py-2 focus:text-tech-navy font-mono text-xs"
    >
      Skip to content
    </a>

    <!-- Scroll progress bar with dual-gradient -->
    <div
      id="scroll-progress"
      class="fixed inset-x-0 top-0 z-[70] h-[2px] origin-left scale-x-0 bg-gradient-to-r from-nature-gold-bright via-[#4ade80] to-tech-cyan shadow-[0_0_8px_rgba(100,255,218,0.7)]"
    >
    </div>

    <!-- ===== HEADER ===== -->
    <header
      id="site-header"
      class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
    >
      <div class="container-px">
        <nav
          class="mt-3.5 flex items-center justify-between rounded-full border border-white/10 bg-surface/75 px-4 py-2.5 backdrop-blur-xl shadow-[0_10px_35px_-10px_rgba(0,0,0,0.6)] md:px-6"
          aria-label="Primary"
        >
          <!-- Brand: avatar + name + status pill -->
          <a href="#hero" class="group flex items-center gap-3 rounded-full" aria-label="Morteza Pourmirzai — home">
            <span class="hero-avatar shrink-0 ring-2 ring-white/10 group-hover:ring-tech-cyan/50 transition-all duration-300">
              <Image
                src={portrait}
                alt="Morteza Pourmirzai"
                width={80}
                height={80}
                densities={[1, 2]}
                loading="eager"
                decoding="async"
              />
            </span>
            <div class="flex flex-col">
              <span class="font-mono text-sm font-bold tracking-tight text-text transition-colors group-hover:text-tech-cyan">
                <span data-i18n="hero.name">{fa.hero.name}</span>
              </span>
              <span class="hidden sm:inline-flex items-center gap-1 font-mono text-[9px] text-muted">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Nature × Code</span>
              </span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <ul class="hidden items-center gap-1 md:flex">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-nav-link={item.href}
                    class="nav-link relative rounded-full px-4 py-2 text-sm text-muted transition-all duration-300 hover:text-text hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60"
                  >
                    <span class="relative z-10" data-i18n={item.key}>{item.label}</span>
                    <span class="nav-underline absolute inset-x-3.5 -bottom-0.5 h-px origin-center scale-x-0 bg-gradient-to-r from-nature-gold-bright to-tech-cyan transition-transform duration-300" />
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- Right Cluster: Sound, Language, Mobile Menu -->
          <div class="flex items-center gap-2">
            <!-- Ambient Audio Synthesizer Toggle -->
            <button
              id="sound-toggle"
              type="button"
              class="group flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-xs text-muted transition-all duration-300 hover:border-tech-cyan/40 hover:text-tech-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60"
              aria-label="Toggle ambient soundscape"
              title="Toggle ambient soundscape"
            >
              <div class="eq-container" aria-hidden="true">
                <span class="eq-bar eq-bar-1"></span>
                <span class="eq-bar eq-bar-2"></span>
                <span class="eq-bar eq-bar-3"></span>
              </div>
              <span class="hidden sm:inline text-[11px] uppercase tracking-wider">Audio</span>
            </button>

            <!-- Language Toggle -->
            <button
              id="lang-toggle"
              type="button"
              class="flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 font-mono text-xs font-semibold text-text transition-all duration-300 hover:border-nature-gold-bright/60 hover:text-nature-gold-bright focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nature-gold-bright/60"
              aria-label="Toggle language"
            >
              <span class="text-nature-gold-bright">◈</span>
              <span data-i18n="meta.langSwitch">{fa.meta.langSwitch}</span>
            </button>

            <!-- Mobile Menu Toggle Button -->
            <button
              id="menu-toggle"
              type="button"
              class="grid h-9 w-9 place-items-center rounded-full border border-white/10 text-muted transition-colors hover:border-tech-cyan hover:text-tech-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60 md:hidden"
              aria-label="Open menu"
              aria-expanded="false"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
            </button>
          </div>
        </nav>

        <!-- Mobile Menu Dropdown -->
        <div
          id="mobile-menu"
          class="mt-2 hidden origin-top flex-col gap-1 rounded-2xl border border-white/10 bg-surface/90 backdrop-blur-2xl p-3 shadow-2xl md:hidden"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-i18n={item.key}
                data-nav-link={item.href}
                class="mobile-link rounded-xl px-4 py-3 text-sm text-muted transition-colors hover:bg-white/5 hover:text-tech-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="main">
      <slot />
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="relative border-t border-white/5 py-14 overflow-hidden">
      <!-- Decorative subtle footer glow -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_100%,rgba(100,255,218,0.04),transparent)] pointer-events-none"></div>

      <div class="container-px relative">
        <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
          <div class="text-center md:text-start">
            <p class="font-mono text-sm font-bold text-text flex items-center gap-2 justify-center md:justify-start">
              <span>Morteza Pourmirzai</span>
              <span class="text-xs text-tech-cyan">·</span>
              <span class="text-xs text-muted font-normal">Conservationist & Developer</span>
            </p>
            <p data-i18n="footer.tagline" class="mt-1 text-sm text-muted">
              {fa.footer.tagline}
            </p>
          </div>

          <div class="flex items-center gap-3">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="grid h-10 w-10 place-items-center rounded-full border border-white/10 bg-white/[0.02] text-muted transition-all duration-300 hover:-translate-y-1 hover:border-tech-cyan hover:text-tech-cyan hover:shadow-[0_0_15px_rgba(100,255,218,0.3)]"
                >
                  <Icon name={s.name} size={18} />
                </a>
              ))
            }
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/5 pt-6 text-xs text-muted sm:flex-row">
          <p>© <span id="year">2026</span> Morteza Pourmirzai. <span data-i18n="footer.rights">{fa.footer.rights}</span></p>
          <p data-i18n="footer.madeWith" class="font-mono text-[11px] text-muted/70">{fa.footer.madeWith}</p>
        </div>
      </div>
    </footer>

    <!-- Global Toast Container -->
    <div id="toast-container" aria-live="polite"></div>

    <!-- ===== SCRIPTS ===== -->
    <script>
      import "@/scripts/i18n";
      import "@/scripts/main";
    </script>
  </body>
</html>
