---
import fa from "../i18n/en.json";
import IranMapSVG from "./svg/IranMapSVG.astro";
import Icon from "./Icon.astro";

// Decorative GitHub-style contribution heat grid
const grid = Array.from({ length: 7 * 22 }, (_, i) => {
  const r = (Math.sin(i * 12.9898) * 43758.5453) % 1;
  const v = Math.abs(r);
  return v > 0.78 ? 3 : v > 0.55 ? 2 : v > 0.3 ? 1 : 0;
});
const cellColor = ["bg-white/5", "bg-tech-cyan/20", "bg-tech-cyan/45", "bg-tech-cyan/80"];
---

<section id="worlds" class="relative overflow-hidden section-pad">
  <div class="container-px">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <p data-reveal class="eyebrow justify-center">
        <Icon name="sparkle" size={14} />
        <span data-i18n="worlds.eyebrow">{fa.worlds.eyebrow}</span>
      </p>
      <h2 data-reveal data-i18n="worlds.title" class="heading-lg tracking-tight">{fa.worlds.title}</h2>
      <p data-reveal data-i18n="worlds.subtitle" class="mx-auto mt-4 text-base sm:text-lg text-muted font-sans max-w-xl">{fa.worlds.subtitle}</p>
    </div>

    <!-- Dual World Master Split Container -->
    <div class="grid overflow-hidden rounded-3xl border border-white/10 lg:grid-cols-2 shadow-2xl">
      
      <!-- ===== NATURE WORLD (Sanctuary Operations) ===== -->
      <div data-reveal class="relative isolate overflow-hidden bg-gradient-to-br from-[#1b3310]/95 via-[#102409] to-[#081505] p-7 sm:p-10 border-b border-white/10 lg:border-b-0 lg:border-r">
        <!-- Ambient Grain & Radial Glow -->
        <div class="absolute inset-0 grain opacity-40 pointer-events-none"></div>
        <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-nature-gold-bright/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <span class="pill border-nature-gold-bright/40 bg-nature-gold-bright/15 text-nature-gold-bright font-mono text-xs font-semibold">
            <span data-i18n="worlds.nature.label">{fa.worlds.nature.label}</span>
          </span>

          <h3 data-i18n="worlds.nature.title" class="mt-5 text-2xl font-bold text-text sm:text-3xl tracking-tight">
            {fa.worlds.nature.title}
          </h3>

          <p data-i18n="worlds.nature.desc" class="mt-3 text-sm sm:text-base text-text/80 leading-relaxed font-sans">
            {fa.worlds.nature.desc}
          </p>

          <!-- Interactive Iran Map -->
          <div class="my-8">
            <div class="flex items-center justify-between mb-2">
              <h4 data-i18n="worlds.nature.locationsTitle" class="font-mono text-xs uppercase tracking-[0.25em] text-nature-gold-bright/90">
                {fa.worlds.nature.locationsTitle}
              </h4>
              <span data-i18n="worlds.nature.locationsHint" class="text-[10px] text-muted font-mono hidden sm:inline">
                {fa.worlds.nature.locationsHint}
              </span>
            </div>
            
            <div class="rounded-2xl border border-white/10 bg-black/40 p-4 shadow-inner">
              <IranMapSVG class="w-full drop-shadow-[0_15px_30px_rgba(0,0,0,0.7)]" />
            </div>
          </div>

          <!-- Organizations & Leadership -->
          <h4 data-i18n="worlds.nature.projectsTitle" class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-nature-gold-bright/90">
            {fa.worlds.nature.projectsTitle}
          </h4>
          <div data-i18n-list="nature-projects" class="space-y-3">
            {
              fa.worlds.nature.projects.map((p) => (
                <a
                  href={p.url || undefined}
                  target={p.url ? "_blank" : undefined}
                  rel={p.url ? "noopener noreferrer" : undefined}
                  role={p.url ? undefined : "group"}
                  class="spotlight-card spotlight-card-gold group flex items-center justify-between gap-3 p-4 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nature-gold-bright/60"
                >
                  <span class="min-w-0">
                    <span class="block font-semibold text-text group-hover:text-nature-gold-bright transition-colors">{p.name}</span>
                    <span class="block text-xs text-muted/90 mt-0.5">{p.desc}</span>
                  </span>
                  {p.url && (
                    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-nature-gold-bright" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 4h6v6m0-6L10 14M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>

          <!-- Key Field Achievements -->
          <h4 data-i18n="worlds.nature.achievementsTitle" class="mb-3 mt-8 font-mono text-xs uppercase tracking-[0.25em] text-nature-gold-bright/90">
            {fa.worlds.nature.achievementsTitle}
          </h4>
          <ul data-i18n-list="nature-achievements" class="space-y-3">
            {
              fa.worlds.nature.achievements.map((t) => (
                <li class="flex items-start gap-3" data-reveal>
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-nature-gold-bright/15 text-nature-gold-bright border border-nature-gold-bright/30 shadow-sm">
                    <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  </span>
                  <span class="text-sm text-text/90 font-sans leading-relaxed">{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- ===== TECH WORLD (Digital Architecture) ===== -->
      <div data-reveal class="relative isolate overflow-hidden bg-gradient-to-br from-[#0a192f]/95 via-[#061224] to-[#020814] p-7 sm:p-10">
        <!-- Cyber grid overlay & ambient cyan glow -->
        <div class="absolute inset-0 opacity-15 [background-image:linear-gradient(to_right,rgba(100,255,218,0.2)_1px,transparent_1px),linear-gradient(to_bottom,rgba(100,255,218,0.2)_1px,transparent_1px)] [background-size:32px_32px]"></div>
        <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-tech-cyan/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <span class="pill border-tech-cyan/40 bg-tech-cyan/15 text-tech-cyan font-mono text-xs font-semibold">
            <span data-i18n="worlds.tech.label">{fa.worlds.tech.label}</span>
          </span>

          <h3 data-i18n="worlds.tech.title" class="mt-5 text-2xl font-bold text-text sm:text-3xl tracking-tight">
            {fa.worlds.tech.title}
          </h3>

          <p data-i18n="worlds.tech.desc" class="mt-3 text-sm sm:text-base text-text/80 leading-relaxed font-sans">
            {fa.worlds.tech.desc}
          </p>

          <!-- Contribution Heat Grid -->
          <div class="my-8 rounded-2xl border border-white/10 bg-black/40 p-4 shadow-inner">
            <div class="mb-2 flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-muted">
              <span class="flex items-center gap-1.5 text-tech-cyan">
                <span class="h-1.5 w-1.5 rounded-full bg-tech-cyan animate-pulse"></span>
                <span>Telemetry Commits & Telemetry Flows</span>
              </span>
              <span class="flex items-center gap-1">
                less
                <span class="inline-block h-2.5 w-2.5 rounded-sm bg-white/5"></span>
                <span class="inline-block h-2.5 w-2.5 rounded-sm bg-tech-cyan/20"></span>
                <span class="inline-block h-2.5 w-2.5 rounded-sm bg-tech-cyan/45"></span>
                <span class="inline-block h-2.5 w-2.5 rounded-sm bg-tech-cyan/80"></span>
                more
              </span>
            </div>
            <div data-reveal class="contrib-grid grid grid-flow-col grid-rows-7 gap-1 overflow-hidden">
              {grid.map((v, i) => <span class={`contrib-cell aspect-square rounded-[3px] ${cellColor[v]}`} style={`--i:${i}`}></span>)}
            </div>
          </div>

          <!-- Technical Arsenal Stack -->
          <h4 data-i18n="worlds.tech.stackTitle" class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-tech-cyan/90">
            {fa.worlds.tech.stackTitle}
          </h4>
          <div data-i18n-list="tech-stack" class="flex flex-wrap gap-2">
            {
              fa.worlds.tech.stack.map((t) => (
                <span class="pill border-tech-cyan/25 bg-tech-cyan/10 text-tech-cyan font-mono text-xs hover:border-tech-cyan/50 hover:bg-tech-cyan/20 transition-all cursor-default" data-reveal>{t}</span>
              ))
            }
          </div>

          <!-- Selected Open-Source Architecture Repos -->
          <h4 data-i18n="worlds.tech.reposTitle" class="mb-3 mt-8 font-mono text-xs uppercase tracking-[0.25em] text-tech-cyan/90">
            {fa.worlds.tech.reposTitle}
          </h4>
          <div data-i18n-list="tech-repos" class="grid gap-3 sm:grid-cols-1">
            {
              fa.worlds.tech.repos.map((r) => (
                <a href={r.url} target="_blank" rel="noopener noreferrer" class="spotlight-card group p-5 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60" data-reveal>
                  <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 font-mono text-sm font-semibold text-text group-hover:text-tech-cyan transition-colors">
                      <svg viewBox="0 0 24 24" class="h-4 w-4 text-tech-cyan/70" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.36 9.36 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" /></svg>
                      {r.name}
                    </span>
                    <svg viewBox="0 0 24 24" class="h-4 w-4 text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-tech-cyan" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6m0-6L10 14M19 14v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
                  </div>
                  <p class="mt-2 text-xs text-muted/90 leading-relaxed font-sans">{r.desc}</p>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="pill border-tech-cyan/20 bg-tech-cyan/5 text-tech-cyan/80 text-[11px] font-mono">{r.tag}</span>
                    <span class="text-[10px] text-muted font-mono uppercase tracking-wider">GitHub Repo</span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
