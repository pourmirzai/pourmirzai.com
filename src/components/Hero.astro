---
import fa from "../i18n/en.json";
import Icon from "./Icon.astro";
import { topoPaths, corridor } from "../data/topo";
---

<section id="hero" class="relative min-h-screen min-h-[100svh] overflow-hidden bg-bg flex flex-col justify-center">
  <!-- ===== ATMOSPHERIC BACKGROUND (Organic × Tech Fusion) ===== -->
  <div class="hero-bg absolute inset-0" aria-hidden="true">
    <!-- Deep gradient backdrop -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#0a192f]/50 via-bg to-[#122409]/45"></div>

    <!-- Organic Wave Boundary SVG -->
    <svg class="absolute inset-0 h-full w-full pointer-events-none" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="waveGradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#c79a3a" stop-opacity="0.22" />
          <stop offset="50%" stop-color="#64ffda" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#2d5016" stop-opacity="0.25" />
        </linearGradient>
        <filter id="waveGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="25" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Morphing organic wave layers -->
      <g filter="url(#waveGlow)">
        <path class="wave wave-1" d="M0,540 Q320,400 640,540 T1280,540 T1920,540 L1920,1080 L0,1080 Z" fill="url(#waveGradient)" opacity="0.6" />
        <path class="wave wave-2" d="M0,580 Q320,440 640,580 T1280,580 T1920,580 L1920,1080 L0,1080 Z" fill="url(#waveGradient)" opacity="0.45" />
      </g>

      <!-- Topographic line accents -->
      <g stroke="#3c6b1f" stroke-opacity="0.25" stroke-width="1.5" fill="none" stroke-linecap="round">
        {topoPaths.slice(0, 12).map((d) => <path class="topo-line" d={d} />)}
      </g>

      <!-- Corridor lines -->
      <g>
        {corridor.map((l, i) => (
          <line
            class="corridor-line"
            x1={l[0]} y1={l[1]} x2={l[2]} y2={l[3]}
            stroke="#64ffda"
            stroke-width="1.8"
            stroke-opacity="0.35"
            stroke-dasharray="4 8"
            style={`animation-delay: ${i * 0.2}s`}
          />
        ))}
      </g>
    </svg>

    <!-- Ambient glowing radial orbs -->
    <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-[#c79a3a]/12 blur-[120px]"></div>
    <div class="absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-[#64ffda]/10 blur-[130px]"></div>

    <!-- Interactive Neural Particles Canvas -->
    <canvas id="fusion-particles" class="absolute inset-0 h-full w-full"></canvas>

    <!-- Film Grain Texture Overlay -->
    <div class="absolute inset-0 grain opacity-25 pointer-events-none"></div>
  </div>

  <!-- ===== FOREGROUND CONTENT ===== -->
  <div class="relative z-10 w-full pt-28 pb-16 md:pt-32 md:pb-24">
    <div class="container-px">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16">
        
        <!-- VISUAL COLUMN: DUAL-CORE INTERACTIVE HUD (5 Cols on LG) -->
        <div data-hero-anim class="order-2 lg:order-1 lg:col-span-5 relative perspective-1000">
          <!-- Main Camera-Trap Telemetry Card (static: no mouse tilt, no spotlight tracking) -->
          <div data-no-tilt class="spotlight-card spotlight-card-gold p-4 sm:p-5 shadow-2xl backdrop-blur-xl border border-nature-gold/30">
            <!-- Header Bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-3 mb-3">
              <div class="flex items-center gap-2 min-w-0 flex-1">
                <span class="relative flex h-2.5 w-2.5 shrink-0">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-nature-gold-bright opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-nature-gold-bright"></span>
                </span>
                <span class="font-mono text-xs font-semibold text-nature-gold-bright tracking-wider uppercase truncate" data-i18n="hero.natureCardTitle">
                  {fa.hero.natureCardTitle}
                </span>
              </div>
              <div class="flex items-center gap-2 shrink-0 ms-auto">
                <button
                  id="ir-toggle"
                  type="button"
                  class="group flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-2.5 py-0.5 font-mono text-[10px] text-emerald-400 hover:border-emerald-400 transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400"
                  aria-label="Toggle IR night-vision camera mode"
                  title="Toggle 850nm Infrared nocturnal filter"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 group-hover:animate-ping"></span>
                  <span data-i18n="hero.irToggle">{fa.hero.irToggle || "IR 850nm"}</span>
                </button>
                <span class="font-mono text-[10px] text-muted border border-white/10 px-2 py-0.5 rounded-full bg-white/5">
                  LIVE REC
                </span>
              </div>
            </div>

            <!-- Image with HUD Grid Overlay (periodic signal-glitch, no mouse input) -->
            <div class="hero-glitch-frame relative aspect-[16/10] overflow-hidden rounded-xl border border-white/10 bg-black/40">
              <img
                src="/images/cheetah-nature.webp"
                alt="Asiatic Cheetah Field Camera-Trap Telemetry"
                class="cheetah-camera-img h-full w-full object-cover"
                loading="eager"
              />
              <!-- Glitch slice layers (aria-hidden duplicates, visible only during glitch bursts) -->
              <img
                src="/images/cheetah-nature.webp"
                alt=""
                aria-hidden="true"
                class="cheetah-camera-img hero-glitch-img hero-glitch-a h-full w-full object-cover"
                loading="eager"
              />
              <img
                src="/images/cheetah-nature.webp"
                alt=""
                aria-hidden="true"
                class="cheetah-camera-img hero-glitch-img hero-glitch-b h-full w-full object-cover"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

              <!-- HUD Reticle & Corner Brackets -->
              <div class="absolute top-2.5 left-2.5 w-4 h-4 border-t-2 border-l-2 border-nature-gold-bright/60"></div>
              <div class="absolute top-2.5 right-2.5 w-4 h-4 border-t-2 border-r-2 border-nature-gold-bright/60"></div>
              <div class="absolute bottom-2.5 left-2.5 w-4 h-4 border-b-2 border-l-2 border-nature-gold-bright/60"></div>
              <div class="absolute bottom-2.5 right-2.5 w-4 h-4 border-b-2 border-r-2 border-nature-gold-bright/60"></div>

              <!-- Telemetry Overlay Data -->
              <div class="absolute bottom-2.5 inset-x-3 flex flex-wrap items-end justify-between gap-2 font-mono text-[11px] text-white/90 drop-shadow pointer-events-none">
                <div class="min-w-0 max-w-[55%]">
                  <div class="text-[9px] text-nature-gold-bright font-bold uppercase tracking-widest truncate">Target Specimen</div>
                  <div class="font-semibold truncate">{fa.hero.telemetry.species}</div>
                </div>
                <div class="text-end shrink-0 ms-auto">
                  <div class="text-[9px] text-tech-cyan uppercase tracking-widest">{fa.hero.telemetry.coordinates}</div>
                  <div class="text-[10px] text-muted truncate">{fa.hero.telemetry.location}</div>
                </div>
              </div>
            </div>

            <!-- Overlapping Code Terminal HUD -->
            <div class="mt-4 rounded-xl border border-white/15 bg-[#030914]/90 backdrop-blur-2xl shadow-xl overflow-hidden text-left" dir="ltr">
              <!-- Terminal Window Bar with Interactive Tabs -->
              <div class="flex items-center justify-between border-b border-white/10 px-3.5 py-2 bg-white/[0.02]">
                <div class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]/80"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]/80"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]/80"></span>
                </div>
                <!-- Interactive Tabs -->
                <div class="flex items-center gap-1 font-mono text-[10px]">
                  <button
                    type="button"
                    data-term-tab="ops"
                    class="px-2 py-0.5 rounded border border-tech-cyan/40 bg-tech-cyan/10 text-tech-cyan transition-colors cursor-pointer"
                  >
                    field_ops.sh
                  </button>
                  <button
                    type="button"
                    data-term-tab="deploy"
                    class="px-2 py-0.5 rounded border border-transparent text-muted hover:text-white transition-colors cursor-pointer"
                  >
                    deploy.ts
                  </button>
                  <button
                    type="button"
                    data-term-tab="ai"
                    class="px-2 py-0.5 rounded border border-transparent text-muted hover:text-white transition-colors cursor-pointer"
                  >
                    habitat_ai.py
                  </button>
                </div>
              </div>

              <!-- Terminal Body Output (Streaming + Interactive CLI) -->
              <div id="terminal-body" class="p-3.5 font-terminal text-[14px] leading-relaxed text-text">
                <!-- Command History Container -->
                <div id="terminal-history" class="space-y-1 mb-2 max-h-32 overflow-y-auto text-xs font-mono empty:hidden"></div>

                <!-- Active Stream / Prompt Line -->
                <div id="terminal-stream-row" class="flex items-center gap-1.5 min-w-0 overflow-hidden">
                  <span class="text-tech-cyan font-bold shrink-0">›</span>
                  <span id="terminal-line" class="text-white/95 font-terminal text-[14px] truncate block flex-1"></span>
                  <span class="text-tech-cyan animate-pulse shrink-0">▋</span>
                </div>

                <!-- Interactive Command Input Prompt -->
                <form id="terminal-form" class="mt-2.5 pt-2 border-t border-white/10 flex items-center gap-2">
                  <span class="font-mono text-xs text-tech-cyan font-semibold shrink-0">msh›</span>
                  <input
                    id="terminal-input"
                    type="text"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="type 'help', 'cheetah', 'touran'..."
                    class="font-mono text-xs text-text bg-transparent outline-none w-full placeholder:text-muted/50"
                  />
                  <span class="hidden sm:inline font-mono text-[9px] text-muted/60 uppercase tracking-widest shrink-0">↵ enter</span>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- TEXT COLUMN: MONUMENTAL EDITORIAL (7 Cols on LG) -->
        <div data-hero-anim class="order-1 lg:order-2 lg:col-span-7 text-center md:text-start hero-text-panel">
          
          <!-- Status Pill -->
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs text-emerald-300 backdrop-blur-md shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            <span class="font-mono text-[11px] font-medium tracking-wide" data-i18n="hero.statusPill">{fa.hero.statusPill}</span>
          </div>

          <!-- Monumental Name Headline with Radiant Iridescence -->
          <h1
            class="text-4xl sm:text-6xl md:text-7xl xl:text-8xl font-black tracking-tight leading-[1.05]"
          >
            <span class="bg-gradient-to-r from-white via-[#e2e8f0] to-[#c79a3a] bg-clip-text text-transparent drop-shadow-sm" data-i18n="hero.name">
              {fa.hero.name}
            </span>
          </h1>

          <!-- Dual Identity Badges -->
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3 md:justify-start font-mono">
            <span class="inline-flex items-center gap-2 rounded-full border border-nature-gold/50 bg-nature-gold/15 px-4 py-2 text-xs font-semibold text-nature-gold-bright backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-nature-gold-bright hover:bg-nature-gold/25">
              <span class="h-2 w-2 rounded-full bg-nature-gold-bright"></span>
              <span data-i18n="hero.roleNature">{fa.hero.roleNature}</span>
            </span>
            
            <span class="fusion-node" aria-hidden="true"><span></span></span>

            <span class="inline-flex items-center gap-2 rounded-full border border-tech-cyan/50 bg-tech-cyan/15 px-4 py-2 text-xs font-semibold text-tech-cyan backdrop-blur-sm shadow-sm transition-all duration-300 hover:border-tech-cyan hover:bg-tech-cyan/25">
              <span class="h-2 w-2 rounded-full bg-tech-cyan"></span>
              <span data-i18n="hero.roleTech">{fa.hero.roleTech}</span>
            </span>
          </div>

          <!-- Atmospheric Lead Intro -->
          <p
            data-i18n="hero.intro"
            class="mt-6 text-base sm:text-lg md:text-xl text-text/85 max-w-2xl leading-relaxed font-sans"
          >
            {fa.hero.intro}
          </p>

          <!-- Interactive Action Buttons -->
          <div class="mt-9 flex flex-wrap items-center justify-center gap-4 md:justify-start">
            <a
              href="#about"
              class="btn btn-gold group px-8 py-3.5 text-sm font-bold tracking-wide shadow-lg shadow-nature-gold/20"
            >
              <span data-i18n="hero.cta_story">{fa.hero.cta_story}</span>
              <Icon name="arrowDown" size={16} class="transition-transform duration-300 group-hover:translate-y-1" />
            </a>

            <a
              href="#worlds"
              class="btn btn-outline group px-8 py-3.5 text-sm font-semibold tracking-wide border-white/20 hover:border-tech-cyan hover:text-tech-cyan"
            >
              <span data-i18n="hero.cta_work">{fa.hero.cta_work}</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>

          <!-- Trust Badges Strip -->
          <div class="mt-12 pt-8 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center md:text-start">
            <div>
              <div class="font-mono text-xl font-bold text-nature-gold-bright" data-i18n="hero.trust.years">{fa.hero.trust.years}</div>
              <div class="text-[11px] text-muted mt-0.5">Asiatic Cheetah Core</div>
            </div>
            <div>
              <div class="font-mono text-xl font-bold text-tech-cyan" data-i18n="hero.trust.sites">{fa.hero.trust.sites}</div>
              <div class="text-[11px] text-muted mt-0.5">Cloud & Web Systems</div>
            </div>
            <div>
              <div class="font-mono text-xl font-bold text-emerald-400" data-i18n="hero.trust.iucn">{fa.hero.trust.iucn}</div>
              <div class="text-[11px] text-muted mt-0.5" data-i18n="hero.trust.iucnNote">{fa.hero.trust.iucnNote || "CEM & WCPA Commissions"}</div>
            </div>
            <div>
              <div class="font-mono text-xl font-bold text-text" data-i18n="hero.trust.leader">{fa.hero.trust.leader}</div>
              <div class="text-[11px] text-muted mt-0.5">Founder, Sarvin Institute</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Ambient Scroll Hint -->
  <a
    href="#about"
    class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 hidden 2xl:flex flex-col items-center gap-2 text-muted/60 hover:text-tech-cyan transition-colors"
    aria-label="Scroll to about section"
  >
    <span class="font-mono text-[10px] uppercase tracking-[0.25em]" data-i18n="hero.scroll">{fa.hero.scroll}</span>
    <div class="w-5 h-8 rounded-full border border-white/20 flex justify-center pt-1.5">
      <span class="w-1 h-2 rounded-full bg-tech-cyan animate-bounce"></span>
    </div>
  </a>
</section>
