---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const sites = [
  {
    id: "touran",
    cx: 265,
    cy: 145,
    labelEn: "Touran Biosphere",
    area: "1.4M ha",
    role: "Primary Breeding Sanctuary"
  },
  {
    id: "miandasht",
    cx: 315,
    cy: 95,
    labelEn: "Miandasht Wildlife Refuge",
    area: "85K ha",
    role: "Steppe Stepping Stone"
  },
];
---

<div class="relative w-full">
  <svg
    class={className}
    viewBox="0 0 500 360"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Interactive map of Iran showing Asiatic Cheetah sanctuaries, the Touran–Miandasht corridor, and the Tehran–Mashhad highway that cuts through it"
  >
    <defs>
      <linearGradient id="iranMeshGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1b3310" stop-opacity="0.75" />
        <stop offset="50%" stop-color="#0f220a" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#061204" stop-opacity="0.95" />
      </linearGradient>

      <linearGradient id="corridorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#c79a3a" stop-opacity="0.9" />
        <stop offset="50%" stop-color="#64ffda" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#c79a3a" stop-opacity="0.9" />
      </linearGradient>

      <filter id="beaconGlow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Detailed stylized Iran landmass polygon -->
    <path
      d="M75,95 L115,65 L160,52 L198,62 L235,80 L285,72 L330,60 L375,70 L425,100 L445,140 L435,195 L405,240 L370,275 L330,305 L285,320 L230,315 L185,285 L145,260 L105,245 L70,205 L55,160 L60,125 Z"
      fill="url(#iranMeshGrad)"
      stroke="#3c6b1f"
      stroke-width="1.8"
      stroke-opacity="0.8"
      class="transition-all duration-500 hover:stroke-[#6b8e4e]"
    />

    <!-- Internal Topographic Elevation Contours -->
    <path
      d="M100,110 Q160,80 230,105 T350,90 T410,130"
      stroke="#6b8e4e"
      stroke-width="1"
      stroke-opacity="0.25"
      stroke-dasharray="4 6"
      fill="none"
    />
    <path
      d="M90,150 Q170,120 250,140 T370,170 T415,220"
      stroke="#6b8e4e"
      stroke-width="1"
      stroke-opacity="0.25"
      stroke-dasharray="3 5"
      fill="none"
    />
    <path
      d="M120,200 Q200,175 280,200 T360,250"
      stroke="#6b8e4e"
      stroke-width="1"
      stroke-opacity="0.2"
      stroke-dasharray="5 7"
      fill="none"
    />

    <!-- Cheetah Dispersal Corridor: Touran ↔ Miandasht -->
    <g class="corridor-paths">
      <path
        d="M265,145 Q290,115 315,95"
        stroke="url(#corridorGrad)"
        stroke-width="2.5"
        stroke-dasharray="4 6"
        stroke-linecap="round"
        class="corridor-line"
      />
    </g>

    <!-- Tehran–Mashhad highway: a deadly barrier crossing the Touran–Miandasht corridor -->
    <g class="highway-group">
      <path
        d="M62,108 Q200,142 288,122 T448,82"
        stroke="#ff5a4e"
        stroke-width="3"
        stroke-dasharray="12 7"
        stroke-linecap="round"
        fill="none"
        opacity="0.75"
        class="highway-line"
      />
      <!-- Warning glyph pinned on the road where it cuts the corridor -->
      <g transform="translate(288,122)">
        <polygon points="0,-7 6.5,5 -6.5,5" fill="#0d0d0d" stroke="#ff5a4e" stroke-width="1.6" />
        <rect x="-0.9" y="-3.2" width="1.8" height="4" rx="0.9" fill="#ff5a4e" />
        <circle cx="0" cy="2.6" r="1" fill="#ff5a4e" />
      </g>
      <text
        x="98"
        y="156"
        text-anchor="start"
        fill="#ff8a7e"
        font-family="var(--font-mono)"
        font-size="9"
        font-weight="600"
        letter-spacing="0.04em"
        class="pointer-events-none"
      >
        ⚠ Tehran–Mashhad Hwy
      </text>
    </g>

    <!-- Sanctuary Interactive Beacons -->
    {sites.map((s, index) => (
      <g
        class="sanctuary-node group cursor-pointer"
        data-sanctuary={s.id}
        data-sanctuary-name={s.labelEn}
        data-sanctuary-area={s.area}
        data-sanctuary-role={s.role}
        tabindex="0"
        role="button"
        aria-label={s.labelEn}
      >
        <circle
          cx={s.cx}
          cy={s.cy}
          r="8"
          fill="none"
          stroke="#c79a3a"
          stroke-width="2.5"
          class="radar-pulse"
          style={`animation-delay: ${index * 0.8}s`}
        />
        <circle
          cx={s.cx}
          cy={s.cy}
          r="24"
          fill="#c79a3a"
          opacity="0.15"
          class="transition-transform duration-300 group-hover:scale-125"
        />
        <circle
          cx={s.cx}
          cy={s.cy}
          r="9"
          fill="#c79a3a"
          filter="url(#beaconGlow)"
          class="transition-all duration-300 group-hover:fill-[#64ffda]"
        />
        <circle
          cx={s.cx}
          cy={s.cy}
          r="3.5"
          fill="#ffffff"
        />
        <text
          x={s.cx}
          y={s.cy + (index === 1 ? -18 : 26)}
          text-anchor="middle"
          fill="#c79a3a"
          font-family="var(--font-mono)"
          font-size="11"
          font-weight="600"
          letter-spacing="0.05em"
          class="pointer-events-none transition-colors duration-300 group-hover:fill-[#64ffda]"
        >
          {s.labelEn}
        </text>
      </g>
    ))}
  </svg>

  <!-- Interactive Sanctuary Live Telemetry Tooltip HUD -->
  <div
    id="sanctuary-hud"
    class="pointer-events-none absolute -bottom-4 left-1/2 -translate-x-1/2 opacity-0 transition-all duration-300 w-11/12 max-w-sm rounded-xl border border-nature-gold/40 bg-[#0d160a]/95 p-3 text-xs shadow-2xl backdrop-blur-md z-20"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-1.5 font-mono text-[10px] text-nature-gold-bright">
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-nature-gold-bright animate-ping"></span>
        <span id="hud-sanctuary-name">Touran Biosphere</span>
      </span>
      <span id="hud-sanctuary-area" class="text-tech-cyan">1,400,000 ha</span>
    </div>
    <p id="hud-sanctuary-role" class="mt-1.5 text-[11px] text-text/90 leading-relaxed font-sans">
      Primary Asiatic Cheetah breeding sanctuary & automated camera-trap network.
    </p>
  </div>
</div>
