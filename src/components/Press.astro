---
import fa from "../i18n/en.json";
import Icon from "./Icon.astro";
import { pressWordmark } from "../scripts/wordmark";
---

<section id="press" class="section-pad relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_50%_0%,rgba(199,154,58,0.07),transparent_70%)]"></div>
  <div class="container-px relative">
    <div class="mx-auto max-w-2xl text-center">
      <p data-reveal class="eyebrow justify-center">
        <Icon name="sparkle" size={14} />
        <span data-i18n="press.eyebrow">{fa.press.eyebrow}</span>
      </p>
      <h2 data-reveal data-i18n="press.title" class="heading-lg">{fa.press.title}</h2>
      <p data-reveal data-i18n="press.subtitle" class="mx-auto mt-4 text-muted">{fa.press.subtitle}</p>
    </div>

    <!-- Press mentions: monogram + name + read affordance (data-driven) -->
    <div
      data-i18n-list="press"
      class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        fa.press.outlets.map((o) => (
          <a
            href={o.url || "#"}
            target={o.url && o.url !== "#" ? "_blank" : undefined}
            rel={o.url && o.url !== "#" ? "noopener noreferrer" : undefined}
            class="press-card group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tech-cyan/60 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
            data-reveal
          >
            <span class="press-wordmark-box flex-1" set:html={pressWordmark(o.name)} />
            <span class="shrink-0">
              <span class="flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted transition-colors group-hover:text-tech-cyan">
                <span data-i18n="press.readLabel">{fa.press.readLabel}</span>
                <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0 transition-transform group-hover:translate-x-0.5 flip-x" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
